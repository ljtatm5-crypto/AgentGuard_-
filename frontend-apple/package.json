{
  "name": "agentguard-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty",
    "test:smoke": "node scripts/run-tests.mjs smoke",
    "test:api": "node scripts/run-tests.mjs api",
    "test:screenshots": "node scripts/run-tests.mjs screenshots",
    "test:smoke:install": "playwright install chromium",
    "check:mock": "vite-node scripts/check-mock.ts",
    "check:trace": "vite-node scripts/check-trace-view.ts",
    "report:pdf": "vite-node scripts/render-report-sample.ts",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^14.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.47.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "msw": "^2.4.9",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.8",
    "vite-node": "^2.1.9"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
