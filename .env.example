AGENTGUARD_DATABASE_URL=sqlite:///./agentguard.db
# PostgreSQL example (use the pooled URL for Vercel Functions):
# AGENTGUARD_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
AGENTGUARD_DB_AUTO_CREATE=true
AGENTGUARD_DB_POOL_SIZE=5
AGENTGUARD_DB_MAX_OVERFLOW=5
AGENTGUARD_DB_POOL_RECYCLE_SECONDS=300
AGENTGUARD_CORS_ORIGINS=http://localhost:5173
AGENTGUARD_DEMO_MODE=true
AGENTGUARD_ALLOWED_TARGET_HOSTS=localhost,127.0.0.1,::1,host.docker.internal
AGENTGUARD_ENVIRONMENT=development

# Public reads are always enabled. Writes require this token in production.
# For a local-only demo you may explicitly opt into anonymous writes instead.
AGENTGUARD_WRITE_TOKEN=
AGENTGUARD_ALLOW_ANONYMOUS_WRITES=false
AGENTGUARD_WRITE_RATE_LIMIT_PER_MINUTE=30
AGENTGUARD_MAX_REQUEST_BYTES=1048576
AGENTGUARD_MAX_CASES_PER_RUN=40
AGENTGUARD_AUDIT_LOG_ENABLED=true

# Optional self-hosted OpenAI-compatible model. Leave disabled for Mock mode.
AGENTGUARD_LLM_ENABLED=false
AGENTGUARD_LLM_CHAT_URL=
AGENTGUARD_LLM_MODEL=
AGENTGUARD_LLM_API_KEY_ENV=
AGENTGUARD_LLM_PROMPT_VERSION=judge-v1
